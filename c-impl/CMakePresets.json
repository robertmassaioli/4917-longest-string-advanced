{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    { "name": "debug", "generator": "Unix Makefiles", "binaryDir": "${sourceDir}/build/make-debug", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "I4917_BUILD_TESTS": "ON" } },
    { "name": "release", "generator": "Unix Makefiles", "binaryDir": "${sourceDir}/build/make-release", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "I4917_BUILD_TESTS": "ON" } },
    { "name": "sanitizers", "generator": "Unix Makefiles", "binaryDir": "${sourceDir}/build/make-sanitizers", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "I4917_BUILD_TESTS": "ON", "I4917_ENABLE_SANITIZERS": "ON" } },
    { "name": "benchmarks", "generator": "Unix Makefiles", "binaryDir": "${sourceDir}/build/make-benchmarks", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "I4917_BUILD_TESTS": "OFF", "I4917_BUILD_BENCHMARKS": "ON" } }
  ],
  "buildPresets": [ { "name": "debug", "configurePreset": "debug" }, { "name": "release", "configurePreset": "release" }, { "name": "sanitizers", "configurePreset": "sanitizers" }, { "name": "benchmarks", "configurePreset": "benchmarks" } ],
  "testPresets": [ { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } }, { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }, { "name": "sanitizers", "configurePreset": "sanitizers", "output": { "outputOnFailure": true } } ]
}
