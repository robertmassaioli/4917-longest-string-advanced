name:                haskell-impl
version:             0.1.0.0
synopsis:            Haskell rewrite of the C++ library
description:         A Haskell implementation of the client-server task processing library
license:             BSD3
author:              Your Name
maintainer:          your.email@example.com
copyright:           2026 Your Name
category:            Network
build-type:          Simple
cabal-version:       >=1.10

library
  exposed-modules:     Processor
  build-depends:       base >=4.7 && <5
                     , vector >=0.12 && <0.14
  hs-source-dirs:      src
  default-language:    Haskell2010
  ghc-options:         -Wall

executable haskell-impl
  main-is:             Main.hs
  build-depends:       base >=4.7 && <5
                     , vector >=0.12 && <0.14
                     , haskell-impl
  hs-source-dirs:      src
  default-language:    Haskell2010
  ghc-options:         -Wall
