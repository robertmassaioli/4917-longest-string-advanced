name:                cli4917
version:             0.1.0.0
synopsis:            Haskell rewrite of the C++ library
description:         A Haskell implementation of the client-server task processing library
license:             BSD3
author:              Your Name
maintainer:          your.email@example.com
copyright:           2026 Your Name
category:            Network
build-type:          Simple
cabal-version:       >=1.10

library
  exposed-modules:     Processor
                     , ClientResults
                     , PackProcessor
                     , SolveTask
                     , Benchmark
                     , ProcessorTests
                     , BruteForceSearch
                     , ExecutionTracing
                     , PatternCache
                     , PatternMatching
                     , PatternAnalyzer
                     , AdvancedPatternCache
                     , InstructionAnalysis
                     , WildcardPatterns
                     , WildcardPatternTests
                     , AdvancedPatternCacheTests
                     , PatternAnalyzerTests
                     , CLI
                     , Commands.Demo
                     , Commands.Benchmark
                     , Commands.CacheDemo
                     , Commands.Test
                     , Commands.Search
                     , Commands.Solve
  build-depends:       base >=4.7 && <5
                     , vector >=0.12 && <0.14
                     , time >=1.9 && <1.13
                     , deepseq >=1.4 && <1.6
                     , aeson >=2.0 && <2.3
                     , containers >=0.6 && <0.8
                     , optparse-applicative >=0.16 && <0.19
                     , directory >=1.3 && <1.4
                     , temporary >=1.3 && <1.4
  hs-source-dirs:      src
  default-language:    Haskell2010
  ghc-options:         -Wall

executable 4917-cli
  main-is:             Main.hs
  build-depends:       base >=4.7 && <5
                     , vector >=0.12 && <0.14
                     , time >=1.9 && <1.13
                     , deepseq >=1.4 && <1.6
                     , aeson >=2.0 && <2.3
                     , containers >=0.6 && <0.8
                     , optparse-applicative >=0.16 && <0.19
                     , directory >=1.3 && <1.4
                     , temporary >=1.3 && <1.4
                     , cli4917
  hs-source-dirs:      src
  default-language:    Haskell2010
  ghc-options:         -Wall

