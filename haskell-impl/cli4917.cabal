name:                cli4917
version:             0.1.0.0
synopsis:            Haskell rewrite of the C++ library
description:         A Haskell implementation of the client-server task processing library
license:             BSD3
author:              Your Name
maintainer:          your.email@example.com
copyright:           2026 Your Name
category:            Network
build-type:          Simple
cabal-version:       >=1.10

library
  exposed-modules:     Processor
                     , TrackedProcessor
                     , ClientResults
                     , PackProcessor
                     , SolveTask
                     , Benchmark
                     , BruteForceSearch
                     , ExecutionTracing
                     , PatternCache
                     , PatternMatching
                     , PatternAnalyzer
                     , AdvancedPatternCache
                     , InstructionAnalysis
                     , LegacyWildcardPatterns
                     , WildcardPattern
                     , CLI
                     , Commands.Demo
                     , Commands.Benchmark
                     , Commands.CacheDemo
                     , Commands.Search
                     , Commands.Solve
  build-depends:       base >=4.7 && <5
                     , vector >=0.12 && <0.14
                     , time >=1.9 && <1.13
                     , deepseq >=1.4 && <1.6
                     , aeson >=2.0 && <2.3
                     , containers >=0.6 && <0.8
                     , optparse-applicative >=0.16 && <0.19
                     , directory >=1.3 && <1.4
                     , temporary >=1.3 && <1.4
                     , hspec >=2.7 && <2.12
  hs-source-dirs:      src
  default-language:    Haskell2010
  ghc-options:         -Wall

executable 4917-cli
  main-is:             Main.hs
  build-depends:       base >=4.7 && <5
                     , vector >=0.12 && <0.14
                     , time >=1.9 && <1.13
                     , deepseq >=1.4 && <1.6
                     , aeson >=2.0 && <2.3
                     , containers >=0.6 && <0.8
                     , optparse-applicative >=0.16 && <0.19
                     , directory >=1.3 && <1.4
                     , temporary >=1.3 && <1.4
                     , cli4917
  hs-source-dirs:      src
  default-language:    Haskell2010
  ghc-options:         -Wall


test-suite spec
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test, src
  main-is:             Spec.hs
  other-modules:       AdvancedPatternCacheSpec
                     , PatternAnalyzerSpec
                     , ProcessorSpec
                     , TrackedProcessorSpec
                     , LegacyWildcardPatternsSpec
                     , WildcardPatternSpec
  ghc-options:         -threaded -rtsopts -with-rtsopts=-N
  build-depends:       base >=4.7 && <5
                     , hspec >=2.7 && <2.12
                     , QuickCheck >=2.13 && <2.16
                     , cli4917
                     , vector >=0.12 && <0.14
                     , time >=1.9 && <1.13
                     , aeson >=2.0 && <2.3
                     , containers >=0.6 && <0.8
                     , directory >=1.3 && <1.4
                     , temporary >=1.3 && <1.4
                     , deepseq >=1.4 && <1.6
  default-language:    Haskell2010


benchmark trackedprocessor-bench
  type:                exitcode-stdio-1.0
  main-is:             TrackedProcessorBench.hs
  hs-source-dirs:      bench, src
  ghc-options:         -O2 -threaded -rtsopts -with-rtsopts=-N
  build-depends:       base >=4.7 && <5
                     , cli4917
                     , criterion >=1.5 && <1.7
                     , vector >=0.12 && <0.14
                     , time >=1.9 && <1.13
                     , deepseq >=1.4 && <1.6
                     , containers >=0.6 && <0.8
  default-language:    Haskell2010
